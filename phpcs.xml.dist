<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Faytuks Structured Data">
	<description>WordPress Coding Standards for the Faytuks Structured Data plugin.</description>

	<file>fn-structured-data.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.3-"/>

	<rule ref="WordPress">
		<!--
			The plugin uses PSR-4 autoloading, so class files are named after the
			class (Settings.php) rather than the class-*.php convention.
		-->
		<exclude name="WordPress.Files.FileName"/>
		<!--
			Rank Math's public filter is literally named `rank_math/json_ld`, so
			it has to be referenced with a slash. Hooks this plugin defines are
			all underscore separated and prefixed `fn_structured_data_`.
		-->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fn-structured-data"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="fn_structured_data"/>
				<element value="FN_STRUCTURED_DATA"/>
				<element value="Faytuks\StructuredData"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!-- Test doubles intentionally declare WordPress-shaped globals and functions. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/.build/*</exclude-pattern>
</ruleset>
