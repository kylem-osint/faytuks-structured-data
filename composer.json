{
  "name": "faytuksnetwork/fn-structured-data",
  "version": "1.0.0",
  "description": "Faytuks Structured Data WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.0",
    "ext-json": "*",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Faytuks\\StructuredData\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Faytuks\\StructuredData\\Tests\\": "tests/support/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check": [
      "@composer validate --no-check-publish",
      "@lint",
      "@analyse",
      "@test:unit"
    ],
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit -c phpunit.unit.xml.dist",
    "test:integration:prepare": "bash tests/bin/normalize-wp-tests-config.sh",
    "test:integration": [
      "@test:integration:setup",
      "@test:integration:prepare",
      "phpunit -c phpunit.integration.xml.dist",
      "@test:integration:env:down"
    ],
    "test:integration:env:up": "docker compose -f tests/integration/docker-compose.yml up -d --wait",
    "test:integration:env:down": "docker compose -f tests/integration/docker-compose.yml down",
    "test:integration:env:reset": "docker compose -f tests/integration/docker-compose.yml down -v",
    "test:integration:install": "bash tests/bin/install-wp-tests.sh ${WP_TEST_DB_NAME:-wordpress_test} ${WP_TEST_DB_USER:-wordpress} ${WP_TEST_DB_PASS:-wordpress} ${WP_TEST_DB_HOST:-127.0.0.1:3308} ${WP_TEST_VERSION:-6.9.1}",
    "test:integration:setup": [
      "@test:integration:env:up",
      "@test:integration:install"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run PHPCS (WordPress Coding Standards) over the plugin source.",
    "lint:fix": "Auto-fix PHPCS violations where possible.",
    "analyse": "Run PHPStan static analysis.",
    "check": "Run every non-integration quality gate (composer validate, PHPCS, PHPStan, unit tests)."
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.0.30"
    },
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
